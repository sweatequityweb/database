rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@lla.edu';
    }
    // Scholar names: admin only, read and write
    match /names/{id} {
      allow read, write: if isAdmin();
    }
    // Points and settings: any signed-in visitor (including anonymous) can read, only admin can write
    match /logs/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
