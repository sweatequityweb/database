rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@lla.edu';
    }
    // Personal details (names, address, parents, contact): admin only
    match /scholarInfo/{id} {
      allow read, write: if isAdmin();
    }
    // Scholar ID, household ID, entry grade/year: any signed-in visitor reads, only admin writes
    match /scholars/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /logs/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
